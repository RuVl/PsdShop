# SECURITY WARNING: don't run with the debug turned on in production!
DEBUG=False

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY='django_secure_key'

# List of allowed hosts
ALLOWED_HOSTS=127.0.0.1,0.0.0.0,example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# Database connection url (if you use docker-compose make sure host is image name)
DATABASE_URL=psql://user:password@host:port/database

# Scheme of every absolute link handed out (download links, the purchases page in e-mails).
# The host comes from the django_site row - update it after the first deploy.
SITE_SCHEME=https

# Email config for outgoing mail. The scheme picks the backend: smtp+tls:// in production,
# consolemail:// prints to the console (that is what backend/dev.env does).
# Create app password (google) https://myaccount.google.com/apppasswords
# The user is part of a URL, so a @ inside it has to be percent-encoded (%40).
EMAIL_URL=smtp+tls://user%40example.com:app-password@smtp.gmail.com:587
# Sender address in the From: header. Defaults to the EMAIL_URL user.
DEFAULT_FROM_EMAIL=shop@example.com

# Check the MX record of the buyer's e-mail domain at checkout (fails open on DNS trouble)
VALIDATE_EMAIL_MX=True

# plisio.net secret key
PLISIO_SECRET_KEY=plisio-secret-key
