# IDE folder
.idea/
.vscode/

# Design folder
design/

# Virtual enviroment
.venv/
venv/
node_modules/

# Enviroment variables
*.env
# vite mode override (real file; .env.development.dist template stays tracked)
frontend/.env.development

# Secrets (DKIM private keys, etc.)
secrets/

# Logging files
*.log

# Uploads: products/media/ is what nginx serves, products/private/ holds the paid files.
# The directory is the compose volume mount point, so locally it lands under backend/.
backend/products/

# Collected static files (collectstatic)
backend/static/

# Vite-built SPA (build output; `make spa` regenerates them)
backend/storefront/static/storefront/spa/
backend/storefront/templates/storefront/shell.html

# Compiled gettext catalogues (built by startup.sh / `make compilemessages`)
*.mo

# Test docker-compose
test*.yml

todo.txt
l.txt
REVIEW.md
